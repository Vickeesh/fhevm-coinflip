# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env for local development
# For Vercel deployment, set these in your Vercel project settings:
# Project Settings > Environment Variables

# Contract Address (deployed on Sepolia)
VITE_CONTRACT_ADDRESS=0x2B5C509634992c78Ea5103a3401d8F26d2486841

# Network Configuration
VITE_NETWORK=sepolia
VITE_CHAIN_ID=11155111

# RPC URL (Sepolia Testnet)
VITE_RPC_URL=https://ethereum-sepolia.publicnode.com

# FHEVM Gateway URL (Zama Gateway for Sepolia)
VITE_FHEVM_GATEWAY_URL=https://gateway.sepolia.zama.ai

# ============================================
# BACKEND/HARDHAT ENVIRONMENT VARIABLES
# ============================================
# These are for contract deployment only (fhevm-contracts/.env)
# NOT needed for Vercel frontend deployment

# Your Sepolia wallet private key (DO NOT SHARE!)
# Get Sepolia ETH from: https://sepoliafaucet.com/
SEPOLIA_PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL (optional - default is in hardhat.config.js)
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Etherscan API Key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# VERCEL DEPLOYMENT INSTRUCTIONS
# ============================================
# 1. Push your code to GitHub
# 2. Import project in Vercel (https://vercel.com)
# 3. Add these environment variables in Vercel:
#    - VITE_CONTRACT_ADDRESS
#    - VITE_NETWORK
#    - VITE_CHAIN_ID
#    - VITE_RPC_URL
#    - VITE_FHEVM_GATEWAY_URL
# 4. Deploy!

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit your .env file to git
# 2. NEVER share your private key
# 3. Use a separate wallet for testnet
# 4. Keep your private keys secure
# 5. The .env file is already in .gitignore
# 6. Only VITE_ prefixed variables are exposed to the frontend
