{
  "name": "fhevm-coinflip-game",
  "version": "1.0.0",
  "description": "A decentralized coin flip game built with FHEVM (Fully Homomorphic Encryption)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "compile": "cd fhevm-contracts && npm run compile",
    "test": "cd fhevm-contracts && npm run test",
    "deploy": "cd fhevm-contracts && npm run deploy",
    "deploy:sepolia": "cd fhevm-contracts && npm run deploy:sepolia",
    "install:all": "npm install && cd fhevm-contracts && npm install"
  },
  "keywords": [
    "web3",
    "dapp",
    "solidity",
    "react",
    "fhevm",
    "coin-flip",
    "zama"
  ],
  "author": "Vickeesh",
  "license": "MIT",
  "dependencies": {
    "@zama-fhe/relayer-sdk": "0.3.0-6",
    "autoprefixer": "^10.4.16",
    "ethers": "^6.8.0",
    "fhevmjs": "^0.5.8",
    "lucide-react": "^0.294.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
